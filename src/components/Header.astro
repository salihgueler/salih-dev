---
import { navigation, site } from "../config/site";
import SocialLinks from "./SocialLinks.astro";

const normalizeRoute = (value: string): string => {
  const trimmed = value.replace(/\/+$/u, "");
  return trimmed === "" ? "/" : trimmed;
};

const currentRoute = normalizeRoute(Astro.url.pathname);

const isCurrentRoute = (href: string): boolean => {
  const target = normalizeRoute(href);
  if (target === "/") {
    return currentRoute === "/";
  }
  return currentRoute === target || currentRoute.startsWith(`${target}/`);
};
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.name}</a>
  <div class="header-links">
    <SocialLinks />
    <nav aria-label="Primary navigation">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrentRoute(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
