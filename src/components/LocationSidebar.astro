---
import { site } from "../config/site";
---

<aside class="location-sidebar" aria-label="Location and conferences">
  <section class="sidebar-section location-section">
    <h2>Currently located</h2>
    <div class="map">
      <img
        src={site.location.map.src}
        alt={`World map showing ${site.location.city}, ${site.location.country}`}
        width="1024"
        height="624"
        loading="eager"
        decoding="async"
      />
      <span
        class="map-pin"
        style={`--pin-x: ${site.location.coordinates.x}%; --pin-y: ${site.location.coordinates.y}%`}
        aria-hidden="true"
      ></span>
      <span
        class="map-label"
        style={`--pin-x: ${site.location.coordinates.x}%; --pin-y: ${site.location.coordinates.y}%`}
      >
        {site.location.city}, {site.location.country}
      </span>
    </div>
    <p>
      {site.name} is currently based in {site.location.city},{" "}
      {site.location.country}. Last updated {site.location.updated}.
    </p>
    <a
      class="attribution"
      href={site.location.map.attributionUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {site.location.map.attribution}
    </a>
  </section>

  <section class="sidebar-section">
    <h2>Upcoming conferences</h2>
    <ul class="conference-list">
      {
        site.conferences.upcoming.map((conference) => (
          <li>
            <strong>{conference.name}</strong>
            <span>{conference.location}</span>
            <time>{conference.date}</time>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sidebar-section">
    <h2>Recent conferences</h2>
    <ul class="conference-list">
      {
        site.conferences.recent.map((conference) => (
          <li>
            <strong>{conference.name}</strong>
            <span>{conference.location}</span>
            <time>{conference.date}</time>
          </li>
        ))
      }
    </ul>
  </section>
</aside>
