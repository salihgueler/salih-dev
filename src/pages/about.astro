---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="About"
  description={`About ${site.name}, ${site.role.toLowerCase()}.`}
>
  <article class="prose-page">
    <h1>About</h1>
    <div class="prose-page-content">
      {site.bio.long.map((paragraph) => <p>{paragraph}</p>)}
      <h2>Areas of focus</h2>
      <ul>
        {site.focusAreas.map((area) => <li>{area}</li>)}
      </ul>
      <p>
        This site is where I collect writing, talks, and practical notes from
        that work.
      </p>
    </div>
  </article>
</BaseLayout>
