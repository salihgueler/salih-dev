---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import { AGENT_GUIDE } from "../lib/webmcp/visitor-guide";
---

<BaseLayout
  title="About"
  description={`About ${site.name}, ${site.role.toLowerCase()}.`}
>
  <article class="prose-page">
    <h1>About</h1>
    <div class="prose-page-content">
      {site.bio.long.map((paragraph) => <p>{paragraph}</p>)}
      <h2>Areas of focus</h2>
      <ul>
        {site.focusAreas.map((area) => <li>{area}</li>)}
      </ul>
      <p>
        This site is where I collect writing, talks, and practical notes from
        that work.
      </p>
      <h2>{AGENT_GUIDE.heading}</h2>
      <p>{AGENT_GUIDE.intro}</p>
      <p>{AGENT_GUIDE.promptsLead}</p>
      <ul>
        {AGENT_GUIDE.prompts.map((prompt) => <li>{prompt}</li>)}
      </ul>
      <p>
        WebMCP is still experimental. In Chrome, turn on
        <code>{AGENT_GUIDE.flag}</code>, reload a page here, and run
        <code>{AGENT_GUIDE.consoleCall}</code> in the DevTools console to see
        the tools. The full list is in
        <a href={AGENT_GUIDE.toolListPath}>webmcp.json</a>.
      </p>
    </div>
  </article>
</BaseLayout>
