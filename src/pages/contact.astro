---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="Contact"
  description={`Connect with ${site.name} about developer advocacy, speaking, frontend and mobile development, developer experience, or serverless architecture.`}
>
  <article class="prose-page">
    <h1>Contact</h1>
    <div class="prose-page-content">
      <p>
        You can find me on the profiles below for speaking, community, and
        technical conversations.
      </p>
      <div class="contact-links">
        {
          site.email && (
            <a href={`mailto:${site.email}`}>
              <span>Email</span>
              <span>{site.email}</span>
            </a>
          )
        }
        {
          site.socials.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer">
              <span>{social.label}</span>
              <span aria-hidden="true">-&gt;</span>
            </a>
          ))
        }
      </div>
    </div>
  </article>
</BaseLayout>
