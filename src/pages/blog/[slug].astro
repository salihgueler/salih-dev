---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatDate,
  getPostStaticPaths,
  slugify,
} from "../../lib/content";

export const getStaticPaths = getPostStaticPaths;

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = post.data.canonical ?? new URL(`/blog/${post.id}/`, Astro.site);
const sources = [
  ...(post.data.originalUrl
    ? [{ name: "DEV Community", url: post.data.originalUrl }]
    : []),
  ...post.data.sources,
];
const articleStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    image: post.data.hero.src,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    mainEntityOfPage: canonical.toString(),
    inLanguage: "en",
    keywords: [post.data.category, ...post.data.tags].join(", "),
    ...(sources.length > 0
      ? {
          sameAs: sources.map((source) => source.url),
        }
      : {}),
    author: {
      "@type": "Person",
      name: "Salih Güler",
      url: "https://salih.dev",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://salih.dev/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blog",
        item: "https://salih.dev/blog/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: post.data.title,
        item: canonical.toString(),
      },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.hero.src}
  imageAlt={post.data.hero.alt}
  canonical={canonical.toString()}
  bodyClass="article-page"
  pageType="article"
  publishedTime={post.data.pubDate.toISOString()}
  updatedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()}
  structuredData={articleStructuredData}
>
  <article class="article-shell">
    <header class="article-header">
      <p class="archive-kicker">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          Published {formatDate(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">/</span>
              <time datetime={post.data.updatedDate.toISOString()}>
                Updated {formatDate(post.data.updatedDate)}
              </time>
            </>
          )
        }
      </p>
      <p class="article-summary">
        <strong>Summary:</strong> {post.data.aiSummary}
      </p>
      {
        sources.length > 0 && (
          <p class="article-source">
            Also published on{" "}
            {
              sources.map((source, index) => (
                <>
                  {index > 0 && (index === sources.length - 1 ? " and " : ", ")}
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {source.name}
                  </a>
                </>
              ))
            }
            .
          </p>
        )
      }
    </header>

    <figure>
      <div class="article-hero">
        <img
          src={post.data.hero.src}
          alt={post.data.hero.alt}
          width="1600"
          height="800"
          decoding="async"
        />
      </div>
      <figcaption class="image-credit">
        Image: <a
          href={post.data.hero.creditUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {post.data.hero.credit}
        </a>
      </figcaption>
    </figure>

    <div class="article-body">
      <Content />
    </div>

    <ul class="tag-list" aria-label="Post tags">
      {
        post.data.tags.map((tag) => (
          <li><a href={`/tags/${slugify(tag)}/`}>#{tag}</a></li>
        ))
      }
    </ul>
  </article>
</BaseLayout>
