---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site } from "../config/site";
import { canonicalUrl, markdownAlternatePath } from "../lib/discovery";
import "../styles/global.css";

type StructuredData = Record<string, unknown>;

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  bodyClass?: string;
  pageType?: "website" | "article";
  publishedTime?: string;
  updatedTime?: string;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description = site.description,
  image = site.defaultImage,
  imageAlt = site.description,
  canonical = canonicalUrl(Astro.url.pathname),
  bodyClass = "",
  pageType = "website",
  publishedTime,
  updatedTime,
  structuredData = [],
} = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const markdownAlternate = markdownAlternatePath(Astro.url.pathname);
const baseStructuredData: StructuredData[] = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: site.name,
    url: site.url,
    jobTitle: site.jobTitle,
    worksFor: {
      "@type": "Organization",
      name: site.organization,
      url: "https://aws.amazon.com/",
    },
    ...(site.email ? { email: `mailto:${site.email}` } : {}),
    homeLocation: {
      "@type": "Place",
      name: `${site.location.city}, ${site.location.country}`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    description: site.description,
    inLanguage: "en",
    author: {
      "@type": "Person",
      name: site.name,
      url: site.url,
    },
  },
];
const extraStructuredData = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];
const allStructuredData = [...baseStructuredData, ...extraStructuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={canonical} />
    {
      markdownAlternate && (
        <link
          rel="alternate"
          type="text/markdown"
          href={markdownAlternate}
          title={`${pageTitle} in Markdown`}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    {
      allStructuredData.map((data) => (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(data).replaceAll("<", "\\u003c")}
        />
      ))
    }
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
